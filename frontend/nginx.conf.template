map "${VITE_GATEWAY_URL}" $gateway_origin {
    ~^(?<gateway_origin_value>https?://[^/]+)/?$ $gateway_origin_value;
    default "";
}
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    resolver 127.0.0.11 ipv6=off valid=30s;
    add_header Cache-Control no-store always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    location /api/ {
        # HU-08: un lote de programas analíticos admite hasta 25 MB; el límite por defecto de nginx es 1 MB.
        client_max_body_size 26m;
        proxy_pass $gateway_origin$request_uri;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 20s;
    }
    # HU-18: el análisis interno espera al modelo local hasta AnalisisInterno__TimeoutSegundos (90 s por defecto).
    # Solo esta ruta amplía la espera; con 20 s nginx cortaba la petición y Ollama cancelaba la respuesta.
    location ~ ^/api/homologaciones/solicitudes/[0-9A-Fa-f-]+/analisis-interno$ {
        client_max_body_size 8k;
        proxy_pass $gateway_origin$request_uri;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 120s;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
