# Copiar a .env.sprint1 (ignorado por Git) y completar los valores vacíos.
# Entorno local de desarrollo; nunca usar credenciales institucionales.
# Usar contraseñas aleatorias; la clave de firma JWT requiere 32 bytes UTF-8 como mínimo.
# La clave de cifrado JWE requiere exactamente 32 bytes aleatorios codificados en Base64.
AUTH_SQL_PASSWORD=
AUTH_JWT_ISSUER=homologacion-fisei-local
AUTH_JWT_AUDIENCE=homologacion-fisei-api
AUTH_JWT_KEY=
AUTH_JWT_ENCRYPTION_KEY=
AUTH_ADMIN_USERNAME=admin.demo
AUTH_ADMIN_PASSWORD=

AUTH_HTTP_PORT=5081
CATALOGO_HTTP_PORT=5082
HOMOLOGACION_HTTP_PORT=5083
GATEWAY_HTTP_PORT=5080
FRONTEND_HTTP_PORT=5173
CATALOGO_DATABASE=HomologacionCatalogo
EQUIVALENCIA_UMBRAL_PCT=80

# Destinos internos YARP; se pueden cambiar sin recompilar.
AUTH_SERVICE_URL=http://auth-service:8080/
CATALOGO_SERVICE_URL=http://catalogo-api:8080/
HOMOLOGACION_SERVICE_URL=http://homologacion-service:8080/
