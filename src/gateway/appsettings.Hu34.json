{
  "Https": {
    "Enabled": true,
    "PublicOrigin": "https://localhost"
  },
  "ReverseProxy": {
    "Routes": {
      "frontend-root": {
        "ClusterId": "frontend",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/", "Methods": [ "GET", "HEAD" ] }
      },
      "frontend-login": {
        "ClusterId": "frontend",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/login", "Methods": [ "GET", "HEAD" ] }
      },
      "frontend-panel": {
        "ClusterId": "frontend",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/panel", "Methods": [ "GET", "HEAD" ] }
      },
      "frontend-carreras": {
        "ClusterId": "frontend",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/admin/carreras", "Methods": [ "GET", "HEAD" ] }
      },
      "frontend-validaciones": {
        "ClusterId": "frontend",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/validaciones", "Methods": [ "GET", "HEAD" ] }
      },
      "frontend-assets": {
        "ClusterId": "frontend",
        "AuthorizationPolicy": "anonymous",
        "Match": { "Path": "/assets/{**path}", "Methods": [ "GET", "HEAD" ] }
      }
    },
    "Clusters": {
      "frontend": {
        "Destinations": {
          "primary": { "Address": "http://frontend:8080/" }
        }
      }
    }
  }
}
