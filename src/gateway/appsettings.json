{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-login": {
        "ClusterId": "auth",
        "AuthorizationPolicy": "anonymous",
        "Match": {
          "Path": "/api/auth/login",
          "Methods": [
            "POST"
          ]
        }
      },
      "carreras": {
        "ClusterId": "catalogo",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/carreras",
          "Methods": [
            "GET",
            "POST"
          ]
        }
      },
      "carrera": {
        "ClusterId": "catalogo",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/carreras/{id}",
          "Methods": [
            "PUT",
            "DELETE"
          ]
        }
      },
      "carrera-asignaturas": {
        "ClusterId": "catalogo",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/carreras/{id}/asignaturas",
          "Methods": [
            "GET"
          ]
        }
      },
      "asignaturas": {
        "ClusterId": "catalogo",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/asignaturas",
          "Methods": [
            "POST"
          ]
        }
      },
      "asignatura": {
        "ClusterId": "catalogo",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/asignaturas/{id}",
          "Methods": [
            "GET"
          ]
        }
      },
      "asignatura-unidades": {
        "ClusterId": "catalogo",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/asignaturas/{id}/unidades",
          "Methods": [
            "POST"
          ]
        }
      },
      "homologacion-evaluar": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/homologaciones/evaluar",
          "Methods": [
            "POST"
          ]
        }
      },
      "homologacion-validar-antiguedad": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/homologaciones/validar-antiguedad",
          "Methods": [
            "POST"
          ]
        }
      },
      "homologacion-validar-requisitos": {
        "ClusterId": "homologacion",
        "AuthorizationPolicy": "AcademicAccess",
        "Match": {
          "Path": "/api/homologaciones/validar-requisitos",
          "Methods": [
            "POST"
          ]
        }
      }
    },
    "Clusters": {
      "auth": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "catalogo": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      },
      "homologacion": {
        "Destinations": {
          "primary": {
            "Address": ""
          }
        }
      }
    }
  }
}
